# ── Server ────────────────────────────────────────
PORT=5000

# ── JWT ──────────────────────────────────────────
JWT_SECRET=change_me_to_a_random_secret

# ── VAPID (push notifications) ───────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ── Email (Gmail) ────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com

# ── Database (MySQL) ─────────────────────────────
# Local / Docker MySQL:
DB_HOST=localhost        # use "db" when running with Docker compose
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=smart_study_planner

# Aiven / cloud MySQL (overrides above):
# DB_HOST=your-project.aivencloud.com
# DB_PORT=12345
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_password
# DB_NAME=defaultdb
# DB_SSL=true
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# SSL: set "true" for cloud databases (Aiven, PlanetScale, etc.)
DB_SSL=false

# ── Docker-only MySQL vars ───────────────────────
MYSQL_ROOT_PASSWORD=your_db_password
MYSQL_DATABASE=smart_study_planner

# ── Frontend URL (CORS + email links) ────────────
FRONTEND_URL=http://localhost:5173
# Production: FRONTEND_URL=https://your-app.vercel.app

# ── Node version (Render uses this) ──────────────
# NODE_VERSION=20
